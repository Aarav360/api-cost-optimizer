#!/usr/bin/env bash
# The repo's checks, run before every commit and by hand from the project root:  .githooks/pre-commit
# A full run takes about half an hour, most of it in the results/ rebuilds and the two sandbox checks; each check prints
# its time and the hook its total. Turn the hook on once per clone, with a relative path so that a commit in a linked worktree runs that
# worktree's own copy of the hook and its checks:  git config core.hooksPath .githooks
# CI (.github/workflows/check.yml) runs the same checks except the hook-only ones, which need results/ (not committed)
# or Docker; several others also have a section that runs only where results/ or the model snapshot is present. Three
# stay manual (README, "Running it"). `HOOK_ONLY` and `MANUAL` in analysis/check_guardrails.py give each one's reason,
# and that check fails a check script nothing runs. check_sandbox, which A17 item 27 puts in the hook, runs near the
# end, after the code check's own sandbox check.
set -euo pipefail

# One check script, its output cut to its FAIL lines and closing count (or to the pattern given), then its time. A
# failing check still prints its time, then stops the hook.
run_check() {
  local module=$1 pattern=${2:-'^FAIL|checks'} started=$SECONDS status=0
  uv run python -m "$module" | grep -E "$pattern" || status=$?
  printf '%5d s  %s\n' "$((SECONDS - started))" "$module"
  return "$status"
}

# The sandbox checks near the end need Docker: if it's down, fail here, not after the slower checks have run.
if ! docker info >/dev/null 2>&1; then
  echo "FAIL  Docker isn't running, and the sandbox checks need it: start Docker Desktop, then run the hook again"
  exit 1
fi

